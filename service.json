{
    "id": "osmium-blog",
    "name": "Osmium Blog",
    "version": "0.12.1",
    "description": "Blog posts written in admin and published as ordinary pages under /blog/, with the markup supplied by the theme",
    "category": "content",
    "author": {
        "name": "Gavin Cox"
    },
    "license": "proprietary",
    "requires": {
        "osmium": ">=1.0.0",
        "php": ">=8.1",
        "services": []
    },
    "autoload": [
        "models"
    ],
    "migrations": "migrations/",
    "hooks": {
        "page.claim": [
            "Osmium\\Services\\Blog\\Models\\BlogClaim::page"
        ],
        "pages.owners": [
            "Osmium\\Services\\Blog\\Models\\BlogOwners::pages"
        ],
        "mcp.tools": [
            "Osmium\\Services\\Blog\\Models\\BlogMcp::tools"
        ],
        "adminbar.context": [
            "Osmium\\Services\\Blog\\Models\\BlogAdminBar::context"
        ],
        "adminbar.links": [
            "Osmium\\Services\\Blog\\Models\\BlogAdminBar::links"
        ]
    },
    "admin": {
        "menu": {
            "section": "Content",
            "items": [
                {
                    "id": "blog",
                    "label": "Blog",
                    "icon": "bx bx-news",
                    "color": "#6c757d",
                    "placement": "group",
                    "group": "content",
                    "order": 10,
                    "route": "admin/blog",
                    "activePattern": "admin/blog*",
                    "role": null
                },
                {
                    "id": "settings",
                    "label": "Osmium Blog",
                    "icon": "bx bx-news",
                    "route": "admin/settings/blog",
                    "activePattern": "admin/settings/blog",
                    "role": "admin"
                }
            ]
        },
        "routes": {
            "admin/blog": {
                "controller": "controllers/BlogController.php",
                "class": "Osmium\\Services\\Blog\\Controllers\\BlogController",
                "method": "index",
                "title": "Osmium Blog"
            },
            "admin/blog/add": {
                "controller": "controllers/BlogController.php",
                "class": "Osmium\\Services\\Blog\\Controllers\\BlogController",
                "method": "add",
                "title": "New Post"
            },
            "admin/blog/edit": {
                "controller": "controllers/BlogController.php",
                "class": "Osmium\\Services\\Blog\\Controllers\\BlogController",
                "method": "edit",
                "title": "Edit Post"
            },
            "admin/settings/blog": {
                "controller": "controllers/SettingsController.php",
                "class": "Osmium\\Services\\Blog\\Controllers\\SettingsController",
                "method": "index",
                "title": "Blog Settings"
            },
            "admin/blog/action": {
                "controller": "controllers/BlogController.php",
                "class": "Osmium\\Services\\Blog\\Controllers\\BlogController",
                "method": "action"
            }
        }
    }
}
